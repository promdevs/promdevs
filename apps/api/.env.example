# API-only secrets. For local development, copy to apps/api/.env.
# The legacy root .env is read only as a local compatibility fallback.
DATABASE_URL=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_TO_NAME=PromDevs Team
CONTACT_FROM_EMAIL=onboarding@resend.dev
CONTACT_FROM_NAME=PromDevs Contact Form

# Optional Cloudflare R2 object storage. Runtime API secrets only.
# Copy the account S3 API endpoint from R2, not a public/custom domain.
# Example: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional HTTPS origin, e.g. https://media.promdevs.com.
# Leave blank until public bucket access is intentionally configured.
R2_PUBLIC_BASE_URL=

# Admin credentials live in admin_users; bootstrap once with pnpm admin:seed-owner --apply.
# No environment login fallback or default credentials. DATABASE_URL is required.
ADMIN_ORIGIN=http://localhost:5173

# API listener. Production Dockerfile sets HOST=0.0.0.0 and NODE_ENV=production.
PORT=4000
HOST=127.0.0.1
# Enable only behind a trusted ingress that sanitizes X-Forwarded-For.
TRUST_PROXY=false
