{
  "name": "@promdevs/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsx --test test/*.test.ts",
    "db:generate": "tsx scripts/generate-migration.ts",
    "db:status": "tsx scripts/check-migrations.ts",
    "db:migrate": "pnpm db:status && drizzle-kit migrate",
    "admin:check": "tsx scripts/check-admin.ts",
    "admin:seed-owner": "tsx scripts/seed-owner.ts",
    "skills:import": "tsx scripts/import-skills.ts",
    "storage:check": "tsx scripts/check-storage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@neondatabase/serverless": "1.1.0",
    "@promdevs/contracts": "workspace:*",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "resend": "6.28.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
