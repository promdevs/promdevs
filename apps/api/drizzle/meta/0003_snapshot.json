        "projects_starting_point_valid": {
          "name": "projects_starting_point_valid",
          "value": "\"projects\".\"starting_point\" in ('idea', 'prototype', 'ai_generated_build', 'unfinished_product', 'established_product')"
        },
        "projects_product_types_valid": {
          "name": "projects_product_types_valid",
          "value": "\"projects\".\"product_types\" <@ ARRAY['website', 'web_app', 'mobile_app', 'ai_product']::text[] and array_position(\"projects\".\"product_types\", null) is null"
        },
        "projects_platforms_valid": {
          "name": "projects_platforms_valid",
          "value": "\"projects\".\"platforms\" <@ ARRAY['web', 'ios', 'android', 'macos', 'windows', 'linux']::text[] and array_position(\"projects\".\"platforms\", null) is null"
        },
        "projects_year_valid": {
          "name": "projects_year_valid",
          "value": "\"projects\".\"year\" is null or \"projects\".\"year\" between 2000 and 2100"
        },
        "projects_sort_order_valid": {
          "name": "projects_sort_order_valid",
          "value": "\"projects\".\"sort_order\" >= 0"
        },
        "projects_live_url_valid": {
          "name": "projects_live_url_valid",
          "value": "\"projects\".\"live_url\" is null or \"projects\".\"live_url\" ~* '^https?://[^/@[:space:]]+([/?#][^[:space:]]*)?$'"
        },
        "projects_github_url_valid": {
          "name": "projects_github_url_valid",
          "value": "\"projects\".\"github_url\" is null or \"projects\".\"github_url\" ~* '^https?://[^/@[:space:]]+([/?#][^[:space:]]*)?$'"
        },
        "projects_app_store_url_valid": {
          "name": "projects_app_store_url_valid",
          "value": "\"projects\".\"app_store_url\" is null or \"projects\".\"app_store_url\" ~* '^https://(apps|itunes)\\.apple\\.com/([a-z]{2}/)?app/([^/?#[:space:]]+/)?id[0-9]+([/?#][^[:space:]]*)?$'"
        },
        "projects_play_store_url_valid": {
          "name": "projects_play_store_url_valid",
          "value": "\"projects\".\"play_store_url\" is null or \"projects\".\"play_store_url\" ~* '^https://play\\.google\\.com/store/apps/details\\?([^#[:space:]]*&)?id=[^&#[:space:]]+(&[^#[:space:]]*)?(#[^[:space:]]*)?$'"
        },
        "projects_show_client_linked": {
          "name": "projects_show_client_linked",
          "value": "not \"projects\".\"show_client\" or \"projects\".\"client_id\" is not null"
        },
        "projects_gallery_valid": {
          "name": "projects_gallery_valid",
          "value": "case when jsonb_typeof(\"projects\".\"gallery\") = 'array' then\n    not jsonb_path_exists(\"projects\".\"gallery\", '$[*] ? (@.type() != \"object\" || !exists(@.type) || !exists(@.src) || (@.type != \"image\" && @.type != \"video\") || @.src.type() != \"string\" || @.src == \"\")')\n    else false end"
        },
        "projects_timeline_valid": {
          "name": "projects_timeline_valid",
          "value": "case\n    when \"projects\".\"timeline\" is null then true\n    when jsonb_typeof(\"projects\".\"timeline\") != 'object' then false\n    when (\"projects\".\"timeline\" - ARRAY['start_date', 'end_date', 'milestones']::text[]) != '{}'::jsonb then false\n    when \"projects\".\"timeline\"->'start_date' is not null and \"projects\".\"timeline\"->'start_date' != 'null'::jsonb\n      and (jsonb_typeof(\"projects\".\"timeline\"->'start_date') != 'string' or (\"projects\".\"timeline\"->>'start_date') !~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$') then false\n    when \"projects\".\"timeline\"->'end_date' is not null and \"projects\".\"timeline\"->'end_date' != 'null'::jsonb\n      and (jsonb_typeof(\"projects\".\"timeline\"->'end_date') != 'string' or (\"projects\".\"timeline\"->>'end_date') !~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$') then false\n    when \"projects\".\"timeline\"->'milestones' is not null and jsonb_typeof(\"projects\".\"timeline\"->'milestones') != 'array' then false\n    else\n      ((\"projects\".\"timeline\"->>'start_date') is null or to_char((\"projects\".\"timeline\"->>'start_date')::date, 'YYYY-MM-DD') = \"projects\".\"timeline\"->>'start_date')\n      and ((\"projects\".\"timeline\"->>'end_date') is null or to_char((\"projects\".\"timeline\"->>'end_date')::date, 'YYYY-MM-DD') = \"projects\".\"timeline\"->>'end_date')\n      and ((\"projects\".\"timeline\"->>'start_date')::date is null or (\"projects\".\"timeline\"->>'end_date')::date is null\n        or (\"projects\".\"timeline\"->>'end_date')::date >= (\"projects\".\"timeline\"->>'start_date')::date)\n      and not jsonb_path_exists(\"projects\".\"timeline\", '$.milestones[*] ? (@.type() != \"object\" || !exists(@.label) || @.label.type() != \"string\" || @.label == \"\" || (exists(@.date) && @.date != null && (@.date.type() != \"string\" || !(@.date like_regex \"^[0-9]{4}-[0-9]{2}-[0-9]{2}$\"))))')\n  end"
        },
        "projects_published_content_ready": {
          "name": "projects_published_content_ready",
          "value": "\"projects\".\"publication_status\" != 'published' or (\n    \"projects\".\"slug\" is not null and length(btrim(\"projects\".\"description\")) > 0\n    and cardinality(\"projects\".\"product_types\") > 0\n    and \"projects\".\"cover_image\" is not null and length(btrim(\"projects\".\"cover_image\")) > 0\n    and \"projects\".\"cover_alt\" is not null and length(btrim(\"projects\".\"cover_alt\")) > 0\n    and \"projects\".\"published_at\" is not null\n  )"
        }
