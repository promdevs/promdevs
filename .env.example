# API-only secrets. For local development, copy to apps/api/.env.
# The legacy root .env is read only as a local compatibility fallback.
DATABASE_URL=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_TO_NAME=PromDevs Team
CONTACT_FROM_EMAIL=onboarding@resend.dev
CONTACT_FROM_NAME=PromDevs Contact Form

# Admin is disabled until both values are configured. No default credentials.
ADMIN_EMAIL=
# Generate with pnpm admin:password. Keep the hash private; quote it in dotenv.
ADMIN_PASSWORD_HASH=
ADMIN_ORIGIN=http://localhost:5173

# API listener. Production Dockerfile sets HOST=0.0.0.0 and NODE_ENV=production.
PORT=4000
HOST=127.0.0.1
# Enable only behind a trusted ingress that sanitizes X-Forwarded-For.
TRUST_PROXY=false
